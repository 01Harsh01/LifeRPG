# For local dev this defaults to SQLite (file:./dev.db) - zero setup required.
# For production, point this at your Postgres instance (Neon/Supabase/Render) and
# change the datasource provider in prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
PORT=4000
NODE_ENV=development
